; COLOR WORLD — Godot 4.4.1 native project
config_version=5
[application]
config/name="COLOR WORLD"
config/icon="res://icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/version="0.9.0"
[display]
window/size/viewport_width=432
window/size/viewport_height=864
window/size/window_width_override=432
window/size/window_height_override=864
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.84,0.9,0.94,1)
[gui]
theme/default_font_multichannel_signed_distance_field=true
[input_devices]
pointing/emulate_touch_from_mouse=true
